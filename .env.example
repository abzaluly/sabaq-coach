# Скопируйте в .env.local и заполните. Никогда не коммитьте реальные значения.

# --- Supabase (публичные: попадают в браузер) ---
# Локально: значения выводит `pnpm db:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (секретные: только сервер) ---
# Нужен Route Handler'ам для обработки пруфов и cron-задач. Не используйте в клиенте.
SUPABASE_SERVICE_ROLE_KEY=

# --- Приложение ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Тесты БД (Vitest) ---
# Любой Postgres ≥ 15 с правами суперпользователя; тесты создают БД orle_test.
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
# Для прогона против `supabase start`:
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
# TEST_SUPABASE=1

# --- SMS (этап 6) ---
# SMS_PROVIDER=mobizon
# SMS_API_KEY=
# SMS_SENDER=
